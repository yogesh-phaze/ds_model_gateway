# Copy this file to .env and fill in real values before deploying.
# Never commit the actual .env file.

# --- General ---
APP_NAME=ai-inference-gateway
API_PREFIX=/api/v1
LOG_LEVEL=INFO

# --- Authentication ---
# Comma-separated list of accepted API keys, e.g. "key-one,key-two".
# Required: replace the default before deploying anywhere non-local.
API_KEYS=changeme-dev-key

# --- Rate limiting (per API key, sliding window, in-memory/single instance) ---
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# --- Concurrency ---
# Hard cap on requests in flight across all models combined.
GATEWAY_MAX_CONCURRENCY=4

# --- octen-embed-service (llama-server, text embeddings) ---
# Reached by container name — gateway must be on the same Docker network.
OCTEN_EMBED_URL=http://octen-embed-service:8080
OCTEN_EMBED_TIMEOUT=30
OCTEN_EMBED_MAX_CONCURRENCY=1
# Must match the --api-key the octen-embed-service container was started with.
OCTEN_EMBED_API_KEY=your-secret-api-key

# --- clip-embed (image_embedding_model-clip-embed-1, CLIP embeddings) ---
CLIP_EMBED_URL=http://image_embedding_model-clip-embed-1:8001
CLIP_EMBED_TIMEOUT=30
CLIP_EMBED_MAX_CONCURRENCY=1
